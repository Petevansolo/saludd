@page "/letrero"
@rendermode InteractiveServer

<div class="alert alert-info">
<h2>@Mensaje</h2>
</div>

<div class="alert alert-info">
    Edad: @age
    Fecha: @Fecha.ToLongDateString()
    bandera: @bandera.ToString()
</div>

<button class="btn btn-primary mb-3" @onclick="Cambio">
