@page "/actividad13"
@rendermode InteractiveServer

<h3>Lista de Actividades</h3>

<div class="row mb-4 mt-4">
    <label class="col-sm-2 col-form-label">Nueva Actividad:</label>
    <div class="col-sm-8">
        <input type="text" class="form-control" placeholder="Escribe una tarea..." @bind="nuevaActividad" />
    </div>
    <div class="col-sm-2">
        <button class="btn btn-primary w-100" @onclick="AgregarActividad">
            Agregar
        </button>
    </div>
</div>

<h4>Actividades por realizar</h4>

@if (actividades.Count == 0)
{
    <div class="alert alert-secondary">No hay actividades pendientes.</div>
}
else
{
    <ul class="list-group mt-3">
        @foreach (var actividad in actividades)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @actividad
                
                <!-- Uso de expresión lambda () => para enviar la actividad específica como parámetro -->
                <button class="btn btn-danger btn-sm" @onclick="() => EliminarActividad(actividad)">
                    Eliminar
                </button>
            </li>
        }
    </ul>
}

@code {
    // Variable para enlazar el texto de entrada
    private string nuevaActividad = "";

    // Colección para almacenar cadenas (concepto nuevo)
    private List<string> actividades = new List<string>();

    private void AgregarActividad()
    {
        // Validamos que no se agreguen tareas vacías o puros espacios (concepto nuevo)
        if (!string.IsNullOrWhiteSpace(nuevaActividad))
        {
            actividades.Add(nuevaActividad);
            
            // Limpiamos el input después de agregar
            nuevaActividad = "";
        }
    }

    // Método que recibe un parámetro
    private void EliminarActividad(string actividadAEliminar)
    {
        // Removemos el elemento específico de la lista (concepto nuevo)
        actividades.Remove(actividadAEliminar);
    }
}